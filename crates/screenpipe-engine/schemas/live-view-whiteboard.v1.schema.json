{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live-view-whiteboard.v1",
  "title": "screenpipe Live View Whiteboard v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "viewport", "notes", "arrows", "strokes"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "live-view-whiteboard.v1"
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "y": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "zoom": { "type": "number", "minimum": 0.25, "maximum": 2.5 }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "x", "y", "width", "height"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "text": { "type": "string", "maxLength": 4000 },
          "x": { "type": "number", "minimum": -100000, "maximum": 100000 },
          "y": { "type": "number", "minimum": -100000, "maximum": 100000 },
          "width": { "type": "number", "minimum": 140, "maximum": 1200 },
          "height": { "type": "number", "minimum": 80, "maximum": 1000 }
        }
      }
    },
    "arrows": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fromId", "toId"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "fromId": {
            "type": "string",
            "pattern": "^note:[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "toId": {
            "type": "string",
            "pattern": "^note:[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "label": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "strokes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "points"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "maxItems": 1024,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "number", "minimum": -100000, "maximum": 100000 },
                "y": { "type": "number", "minimum": -100000, "maximum": 100000 }
              }
            }
          }
        }
      }
    }
  }
}
